{
  "name": "typehealth",
  "version": "0.10.0",
  "description": "Lightweight TypeScript type safety analyzer",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.10.1",
  "author": "Silent-Watcher",
  "homepage": "https://github.com/Silent-Watcher/typehealth#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Silent-Watcher/typehealth.git"
  },
  "bugs": {
    "url": "https://github.com/Silent-Watcher/typehealth/issues"
  },
  "keywords": [
    "typescript",
    "type-safety",
    "type-coverage",
    "static-analysis",
    "code-quality",
    "cli",
    "analyzer"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "typehealth": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsdown": "^0.23.5",
    "vitepress": "^1.6.4"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "typescript": "^5.9.3"
  }
}
